{
  "compileOnSave": false,
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2022", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "paths": {
      "@inboxfm-connect/core-utils": ["./packages/core/utils/src/index.ts"],
      "@inboxfm-connect/core-formula": ["./packages/core/formula/src/index.ts"],
      "@inboxfm-connect/core-piece-types": ["./packages/core/piece-types/src/index.ts"],
      "@inboxfm-connect/core-execution": ["./packages/core/execution/src/index.ts"],
      "@inboxfm-connect/engine": ["./packages/server/engine/src/main.ts"],
      "@inboxfm-connect/server-utils": ["./packages/server/utils/src/index.ts"],
      "@inboxfm-connect/sandbox": ["./packages/server/sandbox/src/index.ts"],
      "@inboxfm-connect/runtime": ["./packages/runtime/src/index.ts"],
      "@inboxfm-connect/shared": ["./packages/core/shared/src/index.ts"],
      "@inboxfm-connect/pieces-framework": ["./packages/integrations/framework/src/index.ts"],
      "@inboxfm-connect/pieces-common": ["./packages/integrations/common/src/index.ts"],
      "ee-embed-sdk": ["./packages/ee/embed-sdk/src/index.ts"]
    },
    "resolveJsonModule": true
  },
  "exclude": ["node_modules", "tmp"]
}
